# ============================================================
# Copy this file to .env for local development.
# On Railway/Render, set these as actual environment variables
# in their dashboard -- never commit a real .env file to git.
# ============================================================

# --- Database (Railway/Render inject this automatically once you
#     attach a Postgres addon; for local dev, point at your own) ---
DATABASE_URL=postgresql://user:password@localhost:5432/anwar_crm

# --- Server ---
PORT=3000

# --- Auth ---
# Generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=anwar_secret_key_2026_safe

# ============================================================
# WhatsApp Cloud API (from Meta Developers -> your App -> WhatsApp
# -> API Setup, Step 2 "Production setup" once your real number
# +967712191198 is linked)
# ============================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
GRAPH_API_VERSION=v21.0

# --- Webhook ---
# WEBHOOK_VERIFY_TOKEN: any secret string YOU invent. You will type
# this exact same value into Meta's dashboard "Verify token" field
# when configuring the webhook Callback URL.
WEBHOOK_VERIFY_TOKEN=choose_your_own_secret_here

# META_APP_SECRET: found in Meta Developers -> your App -> App Settings
# -> Basic -> "App Secret" (click "Show"). Used to verify that
# incoming webhook requests genuinely came from Meta.
META_APP_SECRET=
